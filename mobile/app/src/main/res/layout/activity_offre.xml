<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:padding="15dp"
    tools:context=".OffreActivity">

  <LinearLayout
      android:id="@+id/listeAriane"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <Button
        android:id="@+id/backOffres"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/app_blue"
        android:text="\u003C Offres"
        android:textColor="@color/app_white"
        android:textSize="20sp" />
  </LinearLayout>

  <TextView
      android:id="@+id/titreOffre"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Développeur X++"
      android:textAppearance="@style/TextAppearance.AppCompat.Display1"
      android:textColor="@color/black" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginTop="24dp"
      android:orientation="vertical">

    <TextView
        android:id="@+id/statutOffre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Statut : " />

    <TextView
        android:id="@+id/textView16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entreprise"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/nomEntreprise"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Non renseigné"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/textView18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ville"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/nomVille"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Non renseigné"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/textView19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URI"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/offreUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="web"
        android:text="@string/offre_url"
        android:textColor="@color/black" />

    <Button
        android:id="@+id/buttonCandidature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="Candidater"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

  </LinearLayout>

</LinearLayout>